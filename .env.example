# Скопируй в .env (он в .gitignore). Сервисы читают его через node --env-file-if-exists.
KAFKA_BROKERS=localhost:9092

# Логи всегда JSON. LOG_PRETTY=true — только для чтения глазами в dev (pino-pretty).
LOG_LEVEL=info
LOG_PRETTY=false

SIMULATOR_PORT=3001
SIMULATOR_RATE_PER_SEC=2
SIMULATOR_AUTOSTART=true
# Handle time обращения до interaction.ended, секунды; доля «переставленных» (ended раньше started)
SIMULATOR_HANDLE_SEC_MIN=30
SIMULATOR_HANDLE_SEC_MAX=300
SIMULATOR_REORDER_RATE=0.05

GATEWAY_PORT=3002
# Не задано → своя группа на экземпляр: dashboard-gateway-<host>-<port> (fan-out, ADR 2026-11-08).
# GATEWAY_GROUP_ID=
# true работает только для НОВОЙ группы (у которой ещё нет закоммиченных офсетов)
GATEWAY_FROM_BEGINNING=false
WS_HEARTBEAT_MS=30000

FORECAST_PORT=3003
FORECAST_GROUP_ID=forecast-service
# Прогнозу нужна история: новая группа читает топики с начала
FORECAST_FROM_BEGINNING=true
FORECAST_MIGRATE_ON_START=true
DATABASE_URL=postgres://wfm:wfm@localhost:5432/wfm
# Надёжность: DLQ на consumer group и повторы с backoff
FORECAST_DLQ_TOPIC=forecast-service.dlq
FORECAST_RETRY_BASE_MS=200
FORECAST_RETRY_MAX_MS=10000
FORECAST_UNKNOWN_MAX_ATTEMPTS=5
FORECAST_AHT_MATURITY_SEC=900
