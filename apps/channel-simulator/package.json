{
  "name": "@wfm/channel-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Генерирует входящие обращения (чаты/звонки) и публикует interaction.started в Kafka",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@wfm/contracts": "workspace:*",
    "@wfm/service-kit": "workspace:*",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
}
