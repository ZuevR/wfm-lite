{
  "name": "@wfm/forecast-service",
  "version": "0.1.0",
  "private": true,
  "description": "Читает interaction.started/ended (consumer group forecast-service), хранит обращения в PostgreSQL, считает нагрузку по 15-минутным интервалам и прогноз",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "node --env-file-if-exists=../../.env ../../node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --database-url-var DATABASE_URL"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@wfm/contracts": "workspace:*",
    "@wfm/service-kit": "workspace:*",
    "kafkajs": "^2.2.4",
    "nestjs-pino": "^4.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.0.0"
  }
}
